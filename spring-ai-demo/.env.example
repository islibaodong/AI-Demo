# ============================================================
# 复制本文件为 .env 后填写：  cp .env.example .env
#
# .env 已被 .gitignore 排除，绝不会提交到仓库，可以放心填真实密钥。
# 优先级：真实环境变量 > .env > application.yml 里的默认值
#   —— CI / 生产环境可以只 export 环境变量，无需改动本文件。
#
# 语法注意：
#   * 支持 # 注释行、空行、export KEY=VALUE、成对的单/双引号
#   * 不支持行内注释：KEY=value # 这是注释 会把整段当成值
#   * 不要写空值（KEY=），空值会遮蔽 application.yml 的默认值
# ============================================================

# ---- API 地址：直连官方还是走中转站 ----
# 请求路径 = base-url + /chat/completions，SDK 不会自动补 /v1，所以地址末尾要带 /v1
# OpenAI 官方：https://api.openai.com/v1（保持默认即可）
# 中转站（OpenAI 兼容代理）：改成中转站给你的地址，例如 https://api.your-relay.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# ---- API 密钥（必填）----
OPENAI_API_KEY=

# ---- 模型名：中转站的模型名可能与官方不同，按需修改 ----
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_STT_MODEL=whisper-1
