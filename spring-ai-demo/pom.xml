<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Spring AI 2.0.0 是基于 Spring Boot 4.1 构建的，所以父工程必须是 spring-boot-starter-parent 4.1.x，
      而不是更老的 3.x。如果你用 Boot 3.5 + Spring AI 1.x，父版本需要改成 3.5.x。
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>spring-ai-demo</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>spring-ai-demo</name>
    <description>Spring AI (Java) 循序渐进的 LLM 应用学习示例工程</description>

    <properties>
        <java.version>21</java.version>
        <spring-ai.version>2.0.0</spring-ai.version>

        <!-- 覆盖 Boot 4.1 默认的 h2 2.4.240：该版本存在 CHECK 约束跨会话求值失败的 bug
             （H2 issue #4302，建表连接关闭后新会话插入必报 23514 "Check constraint invalid"），
             2.5.250 已修复。升级 Spring Boot 后若其管理的 H2 >= 2.5.250，此覆盖可删除。 -->
        <h2.version>2.5.250</h2.version>

        <!--
          源码与资源一律按 UTF-8 处理，否则源码里的中文注释、以及
          application.properties / 提示词里的中文会变成乱码。
          spring-boot-starter-parent 虽然已默认设为 UTF-8，但这里显式声明，
          既是为了自文档化，也防止将来更换父工程后失效。
        -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--
              Spring AI 用 BOM 统一管理版本，避免每个 starter 手写版本号。
              这个 BOM 会决定所有 org.springframework.ai:* 的版本。
            -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- OpenAI 聊天模型 starter：自动配置 OpenAiChatModel、EmbeddingModel、ImageModel 等 Bean，
             也自动提供 ChatClient.Builder。 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <!-- Web：提供 REST 端点、SSE 流式能力，也是 ChatClient.Builder 自动装配的前提之一 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 内存向量库 SimpleVectorStore，用于 RAG（lesson06/08）demo。
             SimpleVectorStore 位于 org.springframework.ai:spring-ai-vector-store。 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-vector-store</artifactId>
        </dependency>

        <!-- 现成的向量库 Advisor：QuestionAnswerAdvisor（lesson08）。
             注意 1.x 时代这个 artifact 叫 spring-ai-advisors-vector-store，2.0 改名为
             spring-ai-vector-store-advisor；若引用旧名会报 "version is missing"
             （它已不在 2.0 BOM 里）。 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-vector-store-advisor</artifactId>
        </dependency>

        <!-- 会话记忆的 JDBC 持久化（lesson09）：JdbcChatMemoryRepository + 自动建表。
             数据库由 spring.datasource 决定，本工程配的是 H2 文件库，无需任何外部服务。 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-chat-memory-repository-jdbc</artifactId>
        </dependency>

        <!-- H2：既做运行时的持久化文件库，也是测试里的内存库 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- MCP 客户端（lesson10）：把外部 MCP 服务器暴露的工具接入 ChatClient。
             内含 io.modelcontextprotocol.sdk:mcp（MCP 官方 Java SDK），
             支持 stdio（拉起子进程）与 SSE（HTTP）两种传输。 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-client</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <!-- Spring AI 的部分构件发布在 Spring 的专用仓库里（当前 2.0.0 已在 Maven Central，此处保留以防未来里程碑版本用） -->
    <repositories>
        <repository>
            <id>spring-milestones</id>
            <name>Spring Milestones</name>
            <url>https://repo.spring.io/milestone</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>
</project>